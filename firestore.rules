rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || 
         request.auth.token.email == 'admin@trader24.net' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }
    
    function isRider() {
      return isAuthenticated() && 
        (request.auth.token.role == 'RIDER' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'RIDER' || 
         isAdmin());
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Products (Public read for approved, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service Zones
    match /serviceZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Free essential settings
    match /freeSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Economics Configuration
    match /economicsConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resources
    match /resources/{resId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Riders
    match /riders/{riderId} {
      allow read: if true;
      allow write: if isRider() || isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isRider() || isAdmin() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Free Distributions
    match /freeDistributions/{distId} {
      allow read: if true;
      allow write: if isRider() || isAdmin() || isAuthenticated();
    }

    // Trader Pass Subscriptions
    match /traderPassSubscriptions/{subId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Sponsors
    match /sponsors/{spId} {
      allow read: if true;
      allow write: if true;
    }

    // Inventory Transactions
    match /inventoryTransactions/{txId} {
      allow read: if isRider() || isAdmin();
      allow write: if isRider() || isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
